# 复制成 server/.env 再填值（.env 已被 .gitignore 忽略，不会进仓库）
#
# 主密钥：32 字节 hex，生成办法：openssl rand -hex 32
# 日记正文用 AES-256-GCM 加密后入库，密钥就是它。
# 【一定要备份】这个值丢了，服务器上所有日记都无法恢复。
LD_DATA_KEY=

# 第一幕那道题的答案（比较时忽略大小写和首尾空格）
LD_QUIZ_ANSWER=刘克

# 只监听本机，由 Nginx 反代；不要改成 0.0.0.0
LD_HOST=127.0.0.1
LD_PORT=3000

# 数据目录（数据库 + 备份）。生产环境建议放到仓库外面，例如 /var/lib/liangchao
LD_DATA_DIR=/var/lib/liangchao

# 登录状态保留多少天
LD_SESSION_DAYS=14

# 本地开发想直接让 Node 顺手把静态文件也发出去时，设成 1（线上由 Nginx 发，不要开）
# LD_SERVE_STATIC=1

# ---------- 发验证码用的邮箱 ----------
# 用 QQ 邮箱的话：设置 → 账户 → 开启 SMTP 服务 → 生成「授权码」，
# 授权码填在 LD_SMTP_PASS（不是邮箱登录密码）。
LD_SMTP_HOST=smtp.qq.com
LD_SMTP_PORT=465
# 465 走隐式 TLS；普通端口（如 587）设成 0
LD_SMTP_TLS=1
LD_SMTP_USER=
LD_SMTP_PASS=
# 收件人看到的发件地址，一般和 LD_SMTP_USER 相同
LD_MAIL_FROM=
LD_MAIL_FROM_NAME=我们的小站

# 没配 SMTP 时把验证码打印到服务器日志（本地开发/测试用；线上不要开）
# LD_DEV_MAIL=1