# 统一换行，避免 Windows 上提交的脚本在 Linux 服务器里带着 CRLF
* text=auto

*.sh      text eol=lf
*.service text eol=lf
*.conf    text eol=lf
*.mjs     text eol=lf
*.js      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.example text eol=lf
*.svg     text eol=lf

*.mp3  binary
*.woff binary
*.woff2 binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.gif  binary